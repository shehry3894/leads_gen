# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# Virtual environments (if created inside project)
env/
.venv/
venv/
../venv/
conda-env/
*.conda
*.tar.bz2

# Package manager files
uv.lock
.python-version

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# setuptools develop-install metadata (regenerated by `uv pip install -e .`)
*.egg-info/

