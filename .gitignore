*.xlsx
/streamlit_app/output/
/leads_gen_output/

# Logs and temp files
*.log
*.tmp
logs/

# Environment secrets
.env
*.env

# License keys (sensitive - never commit)
license.key
*.key
licenses/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Documentation drafts (keep final versions)
*_DRAFT.md